<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>movesense_x95_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 (Humble) driver for the MoveSense X95-series stereo depth camera (stereo / depth / color / IMU / YOLO detections).</description>

  <maintainer email="legal@manplus-ai.com">Humanplus</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>

  <exec_depend>ros2launch</exec_depend>

  <!-- external (not rosdep-resolvable): MoveSense_X95_SDK, install it first (see README) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
